{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": {
      "headless": false
    },
    "contextOptions": {
      "viewport": { "width": 1280, "height": 720 }
    }
  },
  "capabilities": ["vision"],
  "testIdAttribute": "data-test",
  "outputDir": ".playwright-mcp",
  "codegen": "typescript",
  "timeouts": {
    "action": 5000,
    "navigation": 60000
  }
}
